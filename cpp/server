// ─── HTTP Request Parsing ─────────────────────────────────────────

struct HttpRequest {
    std::string method;
    std::string path;
    std::string query;
    std::map<std::string,std::string> headers;
    std::string body;
};

HttpRequest parse_request(const std::string& raw) {
    HttpRequest req;
    std::istringstream ss(raw);
    std::string line;
    std::getline(ss, line);
    if (line.empty()) return req;
    // Remove \r
    if (!line.empty() && line.back() == '\r') line.pop_back();

    std::istringstream first(line);
    first >> req.method >> req.path;
    auto q = req.path.find('?');
    if (q != std::string::npos) {
        req.query = req.path.substr(q + 1);
        req.path  = req.path.substr(0, q);
    }

    // Headers
    int content_length = 0;
    while (std::getline(ss, line)) {
        if (!line.empty() && line.back() == '\r') line.pop_back();
        if (line.empty()) break;
        auto colon = line.find(':');
        if (colon != std::string::npos) {
            std::string key = line.substr(0, colon);
            std::string val = line.substr(colon + 2);
            std::transform(key.begin(), key.end(), key.begin(), ::tolower);
            req.headers[key] = val;
            if (key == "content-length")
                content_length = std::stoi(val);
        }
    }

    // Body
    if (content_length > 0) {
        req.body.resize(content_length);
        ss.read(&req.body[0], content_length);
    }
    return req;
}

// ─── Simple JSON value extractor ──────────────────────────────────
std::string json_get(const std::string& json, const std::string& key) {
    std::string search = "\"" + key + "\":\"";
    auto pos = json.find(search);
    if (pos == std::string::npos) return "";
    pos += search.size();
    auto end = json.find('"', pos);
    if (end == std::string::npos) return "";
    return json.substr(pos, end - pos);
}

// ─── Route Handler ────────────────────────────────────────────────

std::string handle_request(const HttpRequest& req) {

    // CORS preflight
    if (req.method == "OPTIONS") {
        return http_response(204, "text/plain", "");
    }

    // ── API Routes ──
    if (req.path.rfind("/api/", 0) == 0) {

        // GET /api/user
        if (req.path == "/api/user" && req.method == "GET") {
            return json_ok(user_to_json());
        }

        // PUT /api/user  — update XP / streak
        if (req.path == "/api/user" && req.method == "PUT") {
            std::lock_guard<std::mutex> lk(g_user_mutex);
            auto xp_str = json_get(req.body, "xp");
            auto st_str = json_get(req.body, "streak");
            if (!xp_str.empty())  g_user.xp     = std::stoi(xp_str);
            if (!st_str.empty())  g_user.streak  = std::stoi(st_str);
            return json_ok(user_to_json());
        }

        // GET /api/kanji/today
        if (req.path == "/api/kanji/today" && req.method == "GET") {
            return json_ok(kanji_today_to_json());
        }

        // GET /api/vocabulary
        if (req.path == "/api/vocabulary" && req.method == "GET") {
            return json_ok(vocab_to_json());
        }

        // GET /api/jlpt
        if (req.path == "/api/jlpt" && req.method == "GET") {
            return json_ok(jlpt_to_json());
        }

        // GET /api/weekly-xp
        if (req.path == "/api/weekly-xp" && req.method == "GET") {
            return json_ok(weekly_xp_to_json());
        }

        // POST /api/auth/magic-link
        if (req.path == "/api/auth/magic-link" && req.method == "POST") {
            auto email = json_get(req.body, "email");
            if (email.empty())
                return json_err(400, "Email is required");
            // In production: send real magic-link email here
            std::cout << "[AUTH] Magic link requested for: " << email << "\n";
            return json_ok("{\"status\":\"sent\",\"email\":\"" + email + "\"}");
        }

        // POST /api/auth/google
        if (req.path == "/api/auth/google" && req.method == "POST") {
            // In production: verify Google token here
            auto token = json_get(req.body, "token");
            (void)token;
            return json_ok("{\"status\":\"ok\",\"redirect\":\"/\"}");
        }

        return json_err(404, "API endpoint not found");
    }

    // ── Static File Serving ──
    if (req.method != "GET") {
        return http_response(405, "text/plain", "Method Not Allowed");
    }

    std::string filepath = std::string(STATIC_DIR) + req.path;

    // Default to index.html for root
    if (req.path == "/" || req.path.empty())
        filepath = std::string(STATIC_DIR) + "/index.html";

    // Basic path traversal guard
    if (filepath.find("..") != std::string::npos) {
        return http_response(400, "text/plain", "Bad Request");
    }

    std::ifstream file(filepath, std::ios::binary);
    if (!file.is_open()) {
        // Try appending .html
        std::ifstream f2(filepath + ".html", std::ios::binary);
        if (!f2.is_open())
            return http_response(404, "text/html",
                "<h1>404 — Page Not Found</h1>");
        std::ostringstream buf;
        buf << f2.rdbuf();
        return http_response(200, "text/html; charset=utf-8", buf.str());
    }

    std::ostringstream buf;
    buf << file.rdbuf();
    std::string body = buf.str();
    std::string mime = get_mime(filepath);
    return http_response(200, mime, body);
}

// ─── Client Connection Handler ────────────────────────────────────

void handle_client(int client_fd) {
    char buffer[MAX_REQUEST + 1] = {};
    ssize_t n = recv(client_fd, buffer, MAX_REQUEST, 0);
    if (n <= 0) { close(client_fd); return; }

    std::string raw(buffer, n);
    HttpRequest req = parse_request(raw);
    std::string response = handle_request(req);

    send(client_fd, response.c_str(), response.size(), 0);
    close(client_fd);
}

// ─── Main ─────────────────────────────────────────────────────────

int main(int argc, char* argv[]) {
    int port = DEFAULT_PORT;
    if (argc > 1) port = std::atoi(argv[1]);

    int server_fd = socket(AF_INET, SOCK_STREAM, 0);
    if (server_fd < 0) { perror("socket"); return 1; }

    int opt = 1;
    setsockopt(server_fd, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));

    sockaddr_in addr{};
    addr.sin_family      = AF_INET;
    addr.sin_addr.s_addr = INADDR_ANY;
    addr.sin_port        = htons(static_cast<uint16_t>(port));

    if (bind(server_fd, (sockaddr*)&addr, sizeof(addr)) < 0) {
        perror("bind"); return 1;
    }
    if (listen(server_fd, BACKLOG) < 0) {
        perror("listen"); return 1;
    }

    std::cout << "╔══════════════════════════════════════╗\n";
    std::cout << "║  NihongoZen C++ HTTP Server          ║\n";
    std::cout << "╠══════════════════════════════════════╣\n";
    std::cout << "║  Port    : " << port                   << "\n";
    std::cout << "║  Serving : " << STATIC_DIR              << "\n";
    std::cout << "╚══════════════════════════════════════╝\n";
    std::cout << "  → http://localhost:" << port << "/login.html\n";
    std::cout << "  → http://localhost:" << port << "/\n\n";

    while (true) {
        sockaddr_in client_addr{};
        socklen_t client_len = sizeof(client_addr);
        int client_fd = accept(server_fd, (sockaddr*)&client_addr, &client_len);
        if (client_fd < 0) continue;

        // Spawn a thread per connection (suitable for low concurrency)
        std::thread([client_fd]() {
            handle_client(client_fd);
        }).detach();
    }

    close(server_fd);
    return 0;
}
