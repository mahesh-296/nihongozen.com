// firestore.rules
// Deploy with: firebase deploy --only firestore:rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection: any signed-in user can read basic profiles (for
    // search / follow / chat display); only the owner can write their own doc
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Progress subcollection
    match /users/{userId}/progress/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Flashcards subcollection (spaced repetition)
    match /users/{userId}/flashcards/{cardId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Public content (lessons, kanji data) – read for all authenticated users
    match /content/{docId} {
      allow read: if request.auth != null;
      allow write: if false; // Admin only via Firebase Console
    }

    // Community chat rooms + messages — any signed-in user can read/post;
    // a message can only be edited/deleted by its author
    match /chat_rooms/{roomId}/messages/{msgId} {
      allow read, create: if request.auth != null;
      allow update, delete: if request.auth != null &&
        request.auth.uid == resource.data.uid;
    }

    // Typing indicators (ephemeral, self-owned per room)
    match /chat_rooms/{roomId}/typing/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Presence (online/offline status) — self-owned doc, readable by all
    match /presence/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Follows — a follow doc is only writable by the follower
    match /follows/{followId} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null &&
        request.auth.uid == request.resource.data.followerUid;
    }

    // Friend requests — sender creates, either party can update (accept/decline)
    match /friend_requests/{reqId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.fromUid;
      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
      allow delete: if request.auth != null &&
        (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
    }

    // Per-user notifications — only that user can read/mark them;
    // anyone signed in can create one addressed to another user (e.g. on follow)
    match /notifications/{userId}/items/{notifId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;
    }

    // Global recent-activity feed (read-only stream of milestones)
    match /activity/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow update, delete: if false;
    }

    // Study groups — any member (or the owner) can read/update; only the
    // owner can delete; any signed-in user can create a group they own
    match /groups/{groupId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerUid;
      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.ownerUid || request.auth.uid in resource.data.members);
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;
    }
    match /groups/{groupId}/messages/{msgId} {
      allow read, create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }
    match /groups/{groupId}/polls/{pollId} {
      allow read, create, update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.createdBy;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
